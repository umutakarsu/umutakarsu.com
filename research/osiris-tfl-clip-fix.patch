@@ -107,3 +107,49 @@ describe('CCTV partial responses', () => {
     expect((await response.json()).pendingRegions).toEqual(['uk']);
   });
 });
+
+/* TfL publishes a still and a ~10s clip per camera, rewritten together every
+   few minutes. The shape below is the live /Place/Type/JamCam record: every
+   property value is a string, including `available`. */
+describe('TfL JamCams', () => {
+  const S3 = 'https://s3-eu-west-1.amazonaws.com/jamcams.tfl.gov.uk';
+  const jamCam = (id: string, props: Record<string, string>) => ({
+    id, lat: 51.5, lon: -0.1, commonName: 'London',
+    additionalProperties: Object.entries(props).map(([key, value]) => ({ category: 'payload', key, value })),
+  });
+  const uk = async () => (await (await GET(new Request('http://localhost/api/cctv?region=uk'))).json()).cameras;
+
+  it('plays the clip and keeps the still for the poster, tiles and fallback', async () => {
+    vi.mocked(stealthFetch).mockResolvedValue(Response.json([
+      jamCam('JamCams_00001.07450', {
+        available: 'true', imageUrl: `${S3}/00001.07450.jpg`, videoUrl: `${S3}/00001.07450.mp4`, view: 'Piccadilly Circus',
+      }),
+    ]));
+    expect(await uk()).toEqual([expect.objectContaining({
+      id: 'tfl-JamCams_00001.07450',
+      feed_url: `${S3}/00001.07450.jpg`,
+      stream_url: `${S3}/00001.07450.mp4`,
+      stream_type: 'mp4',
+      source: 'TfL',
+    })]);
+  });
+
+  it('derives both URLs from the id when the record carries no properties', async () => {
+    vi.mocked(stealthFetch).mockResolvedValue(Response.json([
+      { id: 'JamCams_00001.07450', lat: 51.5, lon: -0.1, commonName: 'London' },
+    ]));
+    expect(await uk()).toEqual([expect.objectContaining({
+      feed_url: `${S3}/00001.07450.jpg`, stream_url: `${S3}/00001.07450.mp4`, stream_type: 'mp4',
+    })]);
+  });
+
+  /* An unavailable camera's files are a placeholder frame and a one-second
+     placeholder clip: a picture of nothing, under a camera's name. */
+  it('leaves out a camera TfL marks unavailable', async () => {
+    vi.mocked(stealthFetch).mockResolvedValue(Response.json([
+      jamCam('JamCams_1', { available: 'false', imageUrl: `${S3}/1.jpg`, videoUrl: `${S3}/1.mp4` }),
+      jamCam('JamCams_2', { available: 'true', imageUrl: `${S3}/2.jpg`, videoUrl: `${S3}/2.mp4` }),
+    ]));
+    expect((await uk()).map((c: { id: string }) => c.id)).toEqual(['tfl-JamCams_2']);
+  });
+});
